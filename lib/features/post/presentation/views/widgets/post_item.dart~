import 'package:flutter/material.dart';
import 'package:flutter_screenutil/flutter_screenutil.dart';
import 'package:instagram_app/features/auth/models/user_model.dart';
import 'package:instagram_app/features/post/data/models/post_model.dart';
import 'package:instagram_app/features/post/presentation/views/widgets/post_image_container.dart';
import '../../../../../core/utils/spacing.dart';
import '../../../../home/presentation/manager/home_cubit.dart';
import '../../../../post/presentation/views/widgets/post_title.dart';
import '../../../../post/presentation/views/widgets/post_user_image_and_name_row.dart';
import '../../manager/get_post_cubit/get_post_cubit.dart';
import 'interactions_with_post_row.dart';

class PostItem extends StatefulWidget {
  const PostItem({
    super.key,
    required this.post,
    required this.user,
  });

  final PostModel post;
  final UserModel user;

  @override
  State<PostItem> createState() => _PostItemState();
}

bool _isLoading = false;

class _PostItemState extends State<PostItem> {
  late ScrollController _scrollController;
  late GetPostCubit _getPostCubit;
  late HomeCubit _homeCubit;

  @override
  void initState() {
    super.initState();
    _homeCubit = HomeCubit.get(context);
    _scrollController = _homeCubit.scrollController;
    _getPostCubit = GetPostCubit.get(context);
    _scrollController.addListener(_scrollListener);
  }

  _scrollListener() async {
    final currentPosition = _scrollController.position.pixels;
    final maxScroll = _scrollController.position.maxScrollExtent;
    if (currentPosition >= 0.7 * maxScroll) {
      if (!_isLoading && _getPostCubit.state is! NoMorePosts) {
        _isLoading = true;
        await _getPostCubit.fetchPosts(userId: HomeCubit.get(context).userId!);
        _isLoading = false;
      }
    }
  }

  @override
  Widget build(BuildContext context) {
    final userModel = widget.user.uId == _homeCubit.userId
        ? _homeCubit.userModel
        : widget.user;
    return Container(
      margin: EdgeInsets.only(
        bottom: 10.h,
        right: 2.w,
        left: 2.w,
      ),
      padding: EdgeInsets.symmetric(horizontal: 16.w, vertical: 12.h),
      width: double.infinity,
      decoration: BoxDecoration(
        color: Colors.white,
        borderRadius: BorderRadius.circular(14.r),
        boxShadow: const [
          BoxShadow(
            color: Colors.black26,
            offset: Offset(0, 2),
            blurRadius: 4,
          ),
        ],
      ),
      child: Column(
        crossAxisAlignment: CrossAxisAlignment.start,
        children: [
          PostUserImageAndNameRow(
            createdAt: widget.post.createdAt,
            userImage: userModel!.profileImageUrl!,
            userName: userModel.name,
          ),
          verticalSpacing(10),
          PostTitle(
            text: widget.post.postTitle!,
          ),
          verticalSpacing(10),
          PostImageContainer(
            postImages: widget.post.postFileUrl!,
          ),
          verticalSpacing(10),
          InteractionsWithPostRow(
            postId: widget.post.postId,
            likesNum: widget.post.likesCount,
            commentsNum: widget.post.commentsCount,
          ),
        ],
      ),
    );
  }
}
