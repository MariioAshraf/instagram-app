class PickStoryIcon extends StatelessWidget {
  const PickStoryIcon({
    super.key,
  });

  @override
  Widget build(BuildContext context) {
    return IconButton(
      padding: EdgeInsets.zero,
      style: IconButton.styleFrom(
        padding: EdgeInsets.zero,
        shape: const CircleBorder(),
      ),
      color: AppColorsManager.mainBlue,
      onPressed: () {
        StoryCubit.get(context).pickStoryMedia();
      },
      icon: Stack(
        children: [
          buildUserProfileImage

            (context,
              radius: 45.r,
              profileImage: HomeCubit.get(context).userModel!.profileImageUrl!),
          Positioned(
            right: 0,
            bottom: 0,
            child: CircleAvatar(
              radius: 21.r,
              backgroundColor: Colors.white,
              child: CircleAvatar(
                radius: 18.r,
                backgroundColor: AppColorsManager.mainBlue,
                child: const Icon(
                  color: Colors.white,
                  Icons.add,
                  size: 28,
                ),
              ),
            ),
          )
        ],
      ),
    );
  }
}
